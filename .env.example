# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payment providers (server-side only; never expose secret keys with NEXT_PUBLIC_)
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=EventSphere <tickets@your-verified-domain.com>

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Public site origin used for ticket URLs and auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@your-domain.com
